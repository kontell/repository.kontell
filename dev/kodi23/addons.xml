       provider-name="kontell">
  <requires>
    <import addon="xbmc.addon" version="12.0.0"/>
  </requires>
  <extension point="xbmc.addon.repository"
             name="Kontell Development Repository">
    <dir minversion="21.0.0" maxversion="21.9.9">
      <info compressed="false">https://repository.kontell.workers.dev/dev/omega/addons.xml</info>
      <checksum>https://repository.kontell.workers.dev/dev/omega/addons.xml.md5</checksum>
      <datadir zip="true">https://repository.kontell.workers.dev/dev/omega</datadir>
    </dir>
    <dir minversion="21.90.0" maxversion="22.9.9">
      <info compressed="false">https://repository.kontell.workers.dev/dev/piers/addons.xml</info>
      <checksum>https://repository.kontell.workers.dev/dev/piers/addons.xml.md5</checksum>
      <datadir zip="true">https://repository.kontell.workers.dev/dev/piers</datadir>
    </dir>
    <!-- No maxversion: a Kodi newer than every channel still reaches this
         repository add-on, and so its next update. Cap it when the next
         channel is added. -->
    <dir minversion="22.90.0">
      <info compressed="false">https://repository.kontell.workers.dev/dev/kodi23/addons.xml</info>
      <checksum>https://repository.kontell.workers.dev/dev/kodi23/addons.xml.md5</checksum>
      <datadir zip="true">https://repository.kontell.workers.dev/dev/kodi23</datadir>
    </dir>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary>Kontell development builds</summary>
    <description>Pre-release builds of Kofin and the other Kontell add-ons. Releases stay in the Kontell Repository.</description>
    <platform>all</platform>
      <path>repository.kontell.dev/repository.kontell.dev-1.0.1.zip</path>
  </extension>
</addon>
<addon id="skin.contuary" version="22.90.0" name="Contuary" provider-name="Kontell">
	<requires>
		<import addon="xbmc.gui" version="5.18.0"/>
		<import addon="script.skin.contuary" version="1.1.0"/>
	</requires>
	<extension point="xbmc.gui.skin" debugging="false">
		<!--
		<res width="1920" height="1440" aspect="4:3" default="false" folder="xml" />
		<res width="1920" height="1280" aspect="3:2" default="false" folder="xml" />
		<res width="1920" height="1200" aspect="16:10" default="false" folder="xml" />
		<res width="2040" height="1080" aspect="17:9" default="false" folder="xml" />
		-->
		<res width="1920" height="1080" aspect="16:9" default="true" folder="xml" />
		<!--
		<res width="2560" height="1080" aspect="21:9" default="false" folder="xml" />
		<res width="2338" height="1080" aspect="19.5:9" default="false" folder="xml" />
		<res width="2160" height="1080" aspect="18:9" default="false" folder="xml" />
		-->
	</extension>
	<extension point="xbmc.addon.metadata">
    <news>v22.90.0
- A pre-release for Kodi 23, in development. Versions now follow Kodi's add-on numbering, where 22.90 comes before 23.
- Synced with Estuary from Kodi 23's development branch. The home screen and Contuary widgets are unchanged.
- Media flag icons take the theme's accent colour, and the dots between details are dimmed.
- Video OSD: rewind and fast forward seek while paused, rather than resuming playback.
- Slideshow: shows each picture's date and time when Kodi's setting for it is on.
- Volume: the passthrough icon shows the level when Kodi's passthrough volume control is on.
- Games: the achievements settings gain a hardcore mode toggle.
- PVR: the channel OSD's heading names the provider and group it was opened from.
- Video versions: labels and icons are correct when versions are flattened into the library.
- Song lists show how far into a song you are, for add-ons that give songs a resume point.
- Home: the music categories row starts with Restore playlist.
- Music OSD: a play speed button.
- These three need Kodi changes that are not in Kodi 23 yet (kontell/xbmc #24, #22 and #15). Without them the song progress and the play speed button stay hidden, and Restore playlist does nothing.</news>
		<summary lang="en_GB">Contuary - A light mod of Estuary for Kodi 23</summary>
		<description lang="en_GB">Contuary is a lightly modified version of the default Estuary skin. A pre-release for Kodi 23, based on its Estuary while it is in development.</description>
		<platform>all</platform>
		<license>GPL-2.0-or-later</license>
		<assets>
			<icon>resources/icon.png</icon>
			<screenshot>resources/screenshot-01.jpg</screenshot>
			<screenshot>resources/screenshot-02.jpg</screenshot>
		</assets>
	    <path>skin.contuary/skin.contuary-22.90.0.zip</path>
  </extension>
</addon>
