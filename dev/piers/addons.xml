<?xml version="1.0" encoding="UTF-8"?>
<addons>
<addon id="plugin.video.kofin" name="Kofin" version="0.93.6" provider-name="kontell">
  <requires>
    
    <import addon="xbmc.addon" version="21.90.802" />
    <import addon="xbmc.python" version="3.0.1" />
    <import addon="script.module.requests" version="2.22.0+matrix.1" />
    <import addon="script.module.websocket" version="1.6.4" />
    
    <import addon="script.kofin.lyrics" version="0.1.0" optional="true" />
    
    <import addon="inputstream.tempo" version="21.4.1" optional="true" />
  </requires>
  <extension point="xbmc.python.pluginsource" library="default.py">
    <provides>video audio</provides>
    
    <medialibraryscanpath content="movies">/native/</medialibraryscanpath>
    <medialibraryscanpath content="tvshows">/native/</medialibraryscanpath>
    <medialibraryscanpath content="musicvideos">/native/</medialibraryscanpath>
  </extension>
  <extension point="xbmc.service" library="service.py" start="login" />
  <extension point="kodi.context.item">
    <menu id="kodi.core.main">
      <item library="context_manage.py">
        <label>30502</label>
        
        <visible>[!String.IsEmpty(ListItem.Property(kofin.id)) | [!String.IsEmpty(ListItem.DBID) + [String.IsEqual(ListItem.DBTYPE,movie) | String.IsEqual(ListItem.DBTYPE,episode) | String.IsEqual(ListItem.DBTYPE,musicvideo) | String.IsEqual(ListItem.DBTYPE,tvshow) | String.IsEqual(ListItem.DBTYPE,season) | String.IsEqual(ListItem.DBTYPE,set) | String.IsEqual(ListItem.DBTYPE,song) | String.IsEqual(ListItem.DBTYPE,album) | String.IsEqual(ListItem.DBTYPE,artist)]] | [String.IsEqual(Container.FolderPath,library://music/kofin/) + String.Contains(ListItem.FileNameAndPath,library://music/kofin/kofinmusic)]]</visible>
      </item>
      <item library="context_play.py">
        <label>30010</label>
        
        <visible>[String.IsEqual(ListItem.DBTYPE,movie) | String.IsEqual(ListItem.DBTYPE,episode) | String.IsEqual(ListItem.DBTYPE,musicvideo) | [!String.IsEmpty(ListItem.Property(kofin.id)) + String.IsEqual(ListItem.DBTYPE,video)]] + [!String.IsEmpty(ListItem.Property(kofin.id)) | !String.IsEmpty(ListItem.DBID)] + !String.IsEmpty(Window(Home).Property(kofin.context.bitrates))</visible>
      </item>
      
      <item library="context_streams.py" args="both">
        <label>30613</label>
        <visible>ListItem.IsPlaying + String.IsEqual(Window(Home).Property(kofin.playing.menu),both)</visible>
      </item>
      <item library="context_streams.py" args="audio">
        <label>30614</label>
        <visible>ListItem.IsPlaying + String.IsEqual(Window(Home).Property(kofin.playing.menu),audio)</visible>
      </item>
      <item library="context_streams.py" args="subtitle">
        <label>30615</label>
        <visible>ListItem.IsPlaying + String.IsEqual(Window(Home).Property(kofin.playing.menu),subtitle)</visible>
      </item>
      </menu>
  </extension>
  <extension point="xbmc.addon.metadata">
    <news>v0.93.6
- Speed up starting playback of an album
- Fix toasts for new content
- Fix movie import looop
- Settings tidy up</news>
    
    <reuselanguageinvoker>true</reuselanguageinvoker>
    <platform>all</platform>
    <license>GPL-3.0-only</license>
    <source>https://github.com/kontell/plugin.video.kofin</source>
    <summary lang="en_GB">Jellyfin client for seamless Kodi integration</summary>
    <description lang="en_GB">Play movies, shows &amp; music from a Jellyfin server.</description>
    
    <assets>
      <icon>resources/media/icon.png</icon>
      <fanart>resources/media/fanart.webp</fanart>
    </assets>
      <path>plugin.video.kofin/plugin.video.kofin-0.93.6.zip</path>
  </extension>
</addon>
<addon id="repository.kontell.dev"
       name="Kontell Development Repository"
       version="1.0.0"
       provider-name="kontell">
  <requires>
    <import addon="xbmc.addon" version="12.0.0"/>
  </requires>
  <extension point="xbmc.addon.repository"
             name="Kontell Development Repository">
    <dir minversion="21.0.0" maxversion="21.9.9">
      <info compressed="false">https://repository.kontell.workers.dev/dev/omega/addons.xml</info>
      <checksum>https://repository.kontell.workers.dev/dev/omega/addons.xml.md5</checksum>
      <datadir zip="true">https://repository.kontell.workers.dev/dev/omega</datadir>
    </dir>
    <dir minversion="21.90.0" maxversion="22.9.9">
      <info compressed="false">https://repository.kontell.workers.dev/dev/piers/addons.xml</info>
      <checksum>https://repository.kontell.workers.dev/dev/piers/addons.xml.md5</checksum>
      <datadir zip="true">https://repository.kontell.workers.dev/dev/piers</datadir>
    </dir>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary>Kontell development builds</summary>
    <description>Pre-release builds of Kofin and the other Kontell add-ons. Releases stay in the Kontell Repository.</description>
    <platform>all</platform>
      <path>repository.kontell.dev/repository.kontell.dev-1.0.0.zip</path>
  </extension>
</addon>
<addon id="service.kofin.companion" name="Kofin Companion" version="0.1.2" provider-name="kontell">
  <requires>
    <!-- Nothing else is declared on purpose: plugin.video.kofin is the same
         add-on id for the SQL build (main), which writes these rows itself,
         so the companion finds the API build through its capability report
         at run time rather than through a dependency. -->
    <import addon="xbmc.python" version="3.0.1"/>
  </requires>
  <extension point="xbmc.service" library="service.py" start="login"/>
  <!-- "Reconcile now" and "Show status" from the add-on's settings. -->
  <extension point="xbmc.python.script" library="default.py"/>
  <extension point="xbmc.addon.metadata">
    <news>v0.1.2
- A large library removal no longer stalls Kodi's other add-ons.</news>
    <summary lang="en_GB">Closes what Kodi's public interfaces cannot for Kofin's API build</summary>
    <description lang="en_GB">Reads the requests Kofin's API build publishes and writes to Kodi's databases what no public interface can: a movie's versions grouped, the server's chapter images in the native chapters dialog, and the rest of the parity ledger. Optional: Kofin works without it and reports which gaps it leaves open.</description>
    <platform>all</platform>
    <license>GPL-3.0-only</license>
    <source>https://github.com/kontell/service.kofin.companion</source>
    <reuselanguageinvoker>false</reuselanguageinvoker>
      <path>service.kofin.companion/service.kofin.companion-0.1.2.zip</path>
  </extension>
</addon>
</addons>
