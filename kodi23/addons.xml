<addon id="script.kofin.lyrics" name="Kofin Lyrics" version="0.3.1" provider-name="kontell">
  <requires>
    <import addon="xbmc.python" version="3.0.1"/>
  </requires>
  <extension point="xbmc.python.lyrics" library="default.py"/>
  <extension point="xbmc.service" library="service.py"/>
  <extension point="xbmc.addon.metadata">
    <news>v0.3.1
• Fixed lyrics stuck on the top row and scrolling in jumps on Kodi 22
• Fixed untimed lyrics opening mid-song
• Fixed the sung line jumping to the top after seeking back
• Fixed the lyrics window starting on the first line when opened mid-song
• Fixed the first arrow press in the lyrics window not scrolling
• Fixed scrolling by hand running past the end of the lyrics
• Fixed the sung line sitting high in skins that don't resize their overlay
• Fixed Kodi freezing if the add-on was updated or disabled with its window open
• Added machine translations for 26 languages, pending review by native speakers
• Removed the debug logging setting; use Kodi's debug logging instead
• Relicensed under GPL v2 or later</news>
    <platform>all</platform>
    <license>GPL-2.0-or-later</license>
    <source>https://github.com/kontell/script.kofin.lyrics</source>
    <forum>https://forum.kodi.tv/showthread.php?tid=388267</forum>
    <website>https://github.com/kontell/plugin.video.kofin/wiki/Lyrics</website>
    <summary lang="en_GB">Song lyrics from your Jellyfin server</summary>
    <description lang="en_GB">Shows lyrics from a Jellyfin server, either in a window drawn by this add-on or handed to a skin.</description>
    <assets>
      <icon>resources/icon.png</icon>
    </assets>
      <path>script.kofin.lyrics/script.kofin.lyrics-0.3.1.zip</path>
  </extension>
</addon>
<!-- The script extension point comes first deliberately: an addon's LibPath is
     taken from its first <extension>, and that is what RunScript resolves when
     the skin's "Recent queues" widget button fires. -->
